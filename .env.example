# Supabase — admin panel for the blog at /admin
# Get these from https://supabase.com/dashboard → your project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service role key — REQUIRED ONLY for the one-time migration script
# (scripts/migrate-cases.mjs). Never commit this. Never expose to the browser.
# Get it from the same Supabase Settings → API page (it's the "service_role" key).
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile CAPTCHA on the /admin login (OPTIONAL).
# 1. Create a widget at https://dash.cloudflare.com → Turnstile → Add site.
# 2. Put the SITE KEY here (public, safe to expose).
# 3. Put the SECRET KEY in Supabase → Authentication → Attack Protection →
#    enable CAPTCHA → provider "Turnstile". Both must be on for it to work.
# Leave blank to disable the captcha (login works without it).
VITE_TURNSTILE_SITE_KEY=
